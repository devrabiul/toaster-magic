{
  "name": "toaster-magic",
  "version": "1.0.1",
  "description": "Lightweight, dependency-free toast notification library with 7 beautiful themes and smooth animations. Works with React, Vue, Next.js, Nuxt, Svelte, Angular, or vanilla JavaScript — ESM, CJS & CDN builds with full TypeScript types.",
  "keywords": [
    "toast",
    "toaster",
    "toast-notification",
    "notifications",
    "notification",
    "toastr",
    "snackbar",
    "alert",
    "message",
    "popup",
    "react",
    "vue",
    "nextjs",
    "nuxt",
    "svelte",
    "angular",
    "vanilla-js",
    "javascript",
    "typescript",
    "browser",
    "esm",
    "cdn",
    "ssr",
    "themes",
    "notification-library"
  ],
  "homepage": "https://github.com/devrabiul/toaster-magic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devrabiul/toaster-magic.git"
  },
  "bugs": {
    "url": "https://github.com/devrabiul/toaster-magic/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Muhammad Rabiul",
    "email": "devrabiul@gmail.com",
    "url": "https://rixetbd.com"
  },
  "funding": "https://github.com/sponsors/devrabiul",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/toaster-magic.global.js",
  "jsdelivr": "./dist/toaster-magic.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./css": "./dist/toaster-magic.css",
    "./css/min": "./dist/toaster-magic.min.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/toaster-magic.global.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "jsdom": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
